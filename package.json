{
  "name": "dj-delivery-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Gerenciador local dos seus downloads autorizados do DJ Delivery",
  "main": "src/main.cjs",
  "scripts": {
    "start": "node src/launch.cjs",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "local.djdelivery.desktop",
    "productName": "Delivery Desktop",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "category": "public.app-category.music"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
